{
  // Type-checks the plain JS frontend; nothing is compiled.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "nodenext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src", "types"]
}
